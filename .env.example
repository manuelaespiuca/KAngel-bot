# ===== OBRIGATÓRIAS =====
# Token do seu bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=cole_o_token_do_seu_bot_aqui

# Chave do Gemini (Google AI Studio)
GEMINI_API_KEY=cole_sua_chave_do_gemini_aqui

# ===== OPCIONAIS =====
# Modelo do Gemini e prefixo dos comandos (se não preencher, usa o padrão)
MODELO_GEMINI=gemini-3.6-flash
PREFIXO=.

# IDs de canais e cargo do seu servidor (0 = desativado / qualquer canal)
CANAL_MUSICA_ID=0
CANAL_ESTUDOS_ID=0
CANAL_BOAS_VINDAS_ID=0
CANAL_SAIDA_ID=0
CARGO_MEMBRO_ID=0

# Link de um GIF para a mensagem de boas-vindas (opcional)
GIF_BOAS_VINDAS_URL=